@page "/"

<PageTitle>Home</PageTitle>
<main class="home-page">
    <section class="home-hero" aria-labelledby="home-heading">
        <p class="eyebrow">Your freelance workspace</p>
        <h1 id="home-heading">Less admin.<br/>More room to create.</h1>
        <p class="home-description">Bring your client relationships together in one simple workspace, so you can focus on the work that matters.</p>
        <AuthorizeView>
            <Authorized>
                <p class="home-status">You're signed in. Your workspace is ready.</p>
                <a class="button-primary" href="dashboard">Open dashboard &rarr;</a>
            </Authorized>
            <NotAuthorized>
                <div class="home-actions">
                    <a class="button-primary" href="register">Get started &rarr;</a>
                    <a class="button-secondary" href="login">Log in</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </section>
    <section class="home-highlight" aria-labelledby="workspace-heading">
        <span class="eyebrow">Built for your day-to-day</span>
        <h2 id="workspace-heading">Your clients. One clear view.</h2>
        <p>Keep your client details close and your next working day a little more organised.</p>
    </section>
</main>